{
  "id": "github.change-notification",
  "kind": "consumer",
  "entry": "index.mjs",
  "config": {
    "geminiBaseUrl": "https://generativelanguage.googleapis.com",
    "geminiModel": "gemini-2.5-flash",
    "notification": {
      "command": "/usr/bin/osascript"
    }
  },
  "env": {
    "GEMINI_API_KEY": "GEMINI_API_KEY"
  },
  "trigger": {
    "type": "events",
    "eventTypes": ["github.commit.created"]
  }
}
