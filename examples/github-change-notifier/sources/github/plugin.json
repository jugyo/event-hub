{
  "id": "github.commits",
  "kind": "source",
  "entry": "index.mjs",
  "config": {
    "repository": "octocat/Hello-World",
    "apiBaseUrl": "https://api.github.com",
    "perPage": 100
  },
  "env": {
    "GITHUB_TOKEN": "WORK_GITHUB_TOKEN"
  },
  "trigger": {
    "type": "poll",
    "every": "5m",
    "backfill": "1d"
  }
}
