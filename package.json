{
  "name": "@jugyo/event-hub",
  "version": "0.2.0",
  "description": "A local event collection and processing service",
  "license": "MIT",
  "author": "Kaz <kkohno@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jugyo/event-hub.git"
  },
  "bugs": {
    "url": "https://github.com/jugyo/event-hub/issues"
  },
  "homepage": "https://github.com/jugyo/event-hub#readme",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "event-hub": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:pack && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:keychain": "EH_KEYCHAIN_TEST=1 node --test --experimental-strip-types test/keychain-opt-in.test.ts",
    "test:pack": "node --test --experimental-strip-types test/package.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@jugyo/duex": "^0.1.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.70.0"
  }
}
